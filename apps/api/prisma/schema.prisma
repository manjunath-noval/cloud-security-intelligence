generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CloudAccount {
  id          String   @id @default(uuid())
  name        String
  provider    String
  accountId   String
  environment String   @default("development")
  region      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}